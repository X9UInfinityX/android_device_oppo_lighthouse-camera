allow hal_camera_default public_adsprpcd_file:file r_file_perms;
allow hal_camera_default vendor_xdsp_device:chr_file r_file_perms;

# System properties
get_prop(hal_camera_default, vendor_soc_id_prop)
allow hal_camera_default aac_drc_prop:file { open read getattr map };
allow hal_camera_default ab_update_gki_prop:file { open read getattr map };
allow hal_camera_default adaptive_haptics_prop:file { open read getattr map };
dontaudit hal_camera_default default_prop:file { open read getattr map };

# /proc/boost_pool/camera
allow hal_camera_default proc:file { write open getattr };

# Binder: HAL ↔ camera app
allow hal_camera_default opluscamera_app:binder { call transfer };

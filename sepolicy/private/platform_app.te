# Gallery is platform-signed in this port but stock Qualcomm policy only grants
# unsigned HexLP access to untrusted_app/priv_app. Retouch IPU face detection
# needs the same client access while running as platform_app.
hal_client_domain(platform_app, vendor_hal_unsignedhexlp)
allow platform_app vendor_hal_hexlp_server:fd use;

# AIUnit extracts downloaded editor plugins into its app data directory and
# loads their JNI libraries from there.
allow platform_app app_data_file:file { r_file_perms execute };
auditallow platform_app app_data_file:file execute;

# Gallery talks to Oplus performance service while rendering editor previews.
allow platform_app horae:binder call;

allow platform_app same_process_hal_file:file { getattr open read map };
allow platform_app selinuxfs:file { getattr open read };

allow platform_app oplus_accesscontrol_service:service_manager find;
allow platform_app security_permission_service:service_manager find;
set_prop(platform_app, oplus_systemclearservice_prop)

# Gallery/editor stock code checks Oplus touch/display properties and loads the
# remapped stock libutils shim while setting up AI editor/HDR pipelines.
get_prop(platform_app, system_oplus_touch_prop)
